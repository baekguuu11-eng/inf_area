  loadingTips:
  - message: "\uC774 \uAC8C\uC784\uC740 \uC57D 9\uAC1C\uC6D4 \uB3D9\uC548 \uAC1C\uBC1C\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    displayTime: 2
  - message: "\uC8FC\uC778\uACF5\uC758 \uC774\uB984\uC740 \uB77C\uD30C\uC5D8\uC785\uB2C8\uB2E4."
    displayTime: 2
  - message: "\uB77C\uD30C\uC5D8\uC740 \uAC10\uC5FC\uB41C \uAD6C\uC5ED\uC744 \uC815\uD654\uD558\uAE30
      \uC704\uD574 \uD22C\uC785\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    displayTime: 2
  - message: "\uAC10\uC5FC\uB41C \uAD6C\uC5ED\uC758 \uBAA8\uB4E0 \uAC8C\uC774\uD2B8\uAC00
      \uC548\uC804\uD55C \uAC83\uC740 \uC544\uB2D9\uB2C8\uB2E4."
    displayTime: 2
  - message: "\uC801\uC744 \uCC98\uCE58\uD558\uBA74 \uBC29\uC744 \uC815\uD654\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    displayTime: 2
  - message: "\uC77C\uBD80 \uC801\uC740 \uC6D0\uAC70\uB9AC \uACF5\uACA9\uC744 \uC0AC\uC6A9\uD569\uB2C8\uB2E4."
    displayTime: 2
  - message: "\uD3EC\uD0C8\uBC29\uC740 \uB2E4\uC74C \uC2A4\uD14C\uC774\uC9C0\uB85C
      \uC774\uC5B4\uC9C0\uB294 \uD575\uC2EC \uC9C0\uC810\uC785\uB2C8\uB2E4."
    displayTime: 2
  - message: "\uAC01 \uC2A4\uD14C\uC774\uC9C0\uB294 \uC77C\uBC18 \uBC29\uACFC \uD3EC\uD0C8\uBC29\uC73C\uB85C
      \uAD6C\uC131\uB429\uB2C8\uB2E4."
    displayTime: 2
  - message: "\uB77C\uD30C\uC5D8\uC758 \uAC80\uC740 \uAC10\uC5FC\uCCB4\uB97C \uBCA0\uC5B4\uB0B4\uAE30
      \uC704\uD574 \uC81C\uC791\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    displayTime: 2
  - message: "\uBD89\uC740 \uACBD\uACE0\uB4F1\uC740 \uAC10\uC5FC \uC704\uD5D8 \uAD6C\uC5ED\uC744
      \uC758\uBBF8\uD569\uB2C8\uB2E4."
    displayTime: 2
  - message: "\uAC8C\uC774\uD2B8\uB97C \uD1B5\uACFC\uD558\uBA74 \uC0C8\uB85C\uC6B4
      \uBC29\uC774 \uC5F4\uB9BD\uB2C8\uB2E4."
    displayTime: 2
  - message: "\uAC10\uC5FC\uB3C4 \uC2DC\uC2A4\uD15C\uC740 \uCD94\uD6C4 \uAC8C\uC784
      \uB09C\uC774\uB3C4\uC5D0 \uC601\uD5A5\uC744 \uC904 \uC608\uC815\uC785\uB2C8\uB2E4."
    displayTime: 2
  - message: "\uAC10\uC5FC\uCCB4\uB4E4\uC740 \uC885\uB958\uC5D0 \uB530\uB77C \uC11C\uB85C
      \uB2E4\uB978 \uBC29\uC2DD\uC73C\uB85C \uACF5\uACA9\uD569\uB2C8\uB2E4."
    displayTime: 2
  - message: "\uAC8C\uC774\uD2B8 \uB108\uBA38\uC5D0\uB294 \uC0C8\uB85C\uC6B4 \uC704\uD5D8\uC774
      \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
    displayTime: 2
  - message: "\uACA9\uB9AC \uC2DC\uC2A4\uD15C\uC774 \uC2E4\uD328\uD55C \uB4A4 \uAC10\uC5FC\uC740
      \uBE60\uB974\uAC8C \uD655\uC0B0\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    displayTime: 2
  - message: "\uB77C\uD30C\uC5D8\uC740 \uB9C8\uC9C0\uB9C9 \uBC31\uC2E0 \uC2E4\uD5D8\uCCB4\uC785\uB2C8\uB2E4."
    displayTime: 2
  - message: "\uD3EC\uD0C8\uC740 \uC544\uC9C1 \uC815\uD654\uB418\uC9C0 \uC54A\uC740
      \uAD6C\uC5ED\uC73C\uB85C \uC774\uC5B4\uC9C8 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    displayTime: 2
  - message: "\uACBD\uACE0 \uD45C\uC2DD\uC774 \uBCF4\uC778\uB2E4\uBA74 \uC2E0\uC911\uD558\uAC8C
      \uC811\uADFC\uD574\uC57C \uD569\uB2C8\uB2E4."
    displayTime: 2
  - message: "\uBC14\uC774\uB7EC\uC2A4\uD615 \uC801\uC740 \uB2E8\uC21C\uD558\uC9C0\uB9CC
      \uBE60\uB974\uAC8C \uC811\uADFC\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    displayTime: 2
  - message: "\uAE30\uACC4\uD615 \uAC10\uC5FC\uCCB4\uB294 \uC608\uCE21\uD558\uAE30
      \uC5B4\uB824\uC6B4 \uC6C0\uC9C1\uC784\uC744 \uBCF4\uC77C \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    displayTime: 2
